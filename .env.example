# ThreadsInsight 本機設定範本。使用方式：
#   cp .env.example .env
# 然後填入下方的值。.env 已列在 .gitignore，請勿提交或分享。
#
# 後端（vp run api:dev）啟動時會讀取這個檔案；已設定的系統環境變數優先。
# Vite 只會把 VITE_ 開頭的變數送進前端，下方的金鑰不會出現在瀏覽器中。

# Anthropic API 金鑰：用於 Claude Haiku 5.5 產生內容策略建議。
# 取得：https://console.anthropic.com/settings/keys
# 留空時，使用者仍可在網頁的「AI 建議設定」輸入自己的金鑰；兩者皆無則只顯示規則引擎的觀察。
ANTHROPIC_API_KEY=

# AI 建議開關：auto（有金鑰才啟用，預設）、on（強制啟用）、off（一律停用，連網頁輸入的金鑰也不使用）。
THREADSINSIGHT_AI=auto

# 後端日誌：json（預設，一行一筆，含 request_id、任務階段耗時、LLM 呼叫狀態）或 text（開發時較好讀）
LOG_FORMAT=json
LOG_LEVEL=INFO

# ---------- Supabase（登入與資料庫，ADR-001）----------
# 本機開發先執行 `supabase start`，再用 `supabase status` 核對下列數值。
# 以下為本機 Supabase CLI 的預設值，可直接使用；連雲端專案時改成該專案的設定。

# 後端用：驗證登入憑證（{SUPABASE_URL}/auth/v1/.well-known/jwks.json 的公鑰），
# 並以「使用者自己的登入憑證」讀寫資料庫，權限由 RLS 決定，後端不需要任何 Supabase 密鑰。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# 前端用（會打包進瀏覽器，屬於可公開的值）。
# 只能放 publishable key（sb_publishable_ 開頭）；絕不可放 secret key 或 service role key。
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# ---------- docker compose（選填，ADR-001）----------
# docker compose up --build 會讀取這個檔案：上方 VITE_ 開頭的值在建置前端時打包進去，其餘在執行時提供給 API。
# 以下兩項通常不用改：容器內以 host.docker.internal 連本機 Supabase，token 的發行者仍是上方的網址。
# DOCKER_SUPABASE_URL=http://host.docker.internal:54321
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# 網頁對外埠號（只綁定本機），預設 8080
# WEB_PORT=8080
