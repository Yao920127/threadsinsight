# ThreadsInsight 本機設定範本。使用方式：
#   cp .env.example .env
# 然後填入下方的值。.env 已列在 .gitignore，請勿提交或分享。
#
# 後端（vp run api:dev）啟動時會讀取這個檔案；已設定的系統環境變數優先。
# Vite 只會把 VITE_ 開頭的變數送進前端，下方的金鑰不會出現在瀏覽器中。

# Anthropic API 金鑰：用於 Claude Haiku 5.5 產生內容策略建議。
# 取得：https://console.anthropic.com/settings/keys
# 留空時，使用者仍可在網頁的「AI 建議設定」輸入自己的金鑰；兩者皆無則只顯示規則引擎的觀察。
ANTHROPIC_API_KEY=

# AI 建議開關：auto（有金鑰才啟用，預設）、on（強制啟用）、off（一律停用，連網頁輸入的金鑰也不使用）。
THREADSINSIGHT_AI=auto

# 後端日誌：json（預設，一行一筆，含 request_id、任務階段耗時、LLM 呼叫狀態）或 text（開發時較好讀）
LOG_FORMAT=json
LOG_LEVEL=INFO

# ---------- 資料庫與登入（ADR-002）----------
# PostgreSQL 連線字串。正式環境（Railway）由平台提供；本機用 docker compose 時會自動設定，不必填。
# 只跑單元測試時不需要資料庫。
DATABASE_URL=

# 登入 cookie 是否只在 HTTPS 送出。正式環境維持 true；本機以 http 開發時設成 false。
COOKIE_SECURE=true

# ---------- docker compose（選用）----------
# 本機 Postgres 的密碼（只在本機使用，預設 local-dev-only）
# LOCAL_DB_PASSWORD=
# 網頁對外埠號（只綁定本機），預設 8080
# WEB_PORT=8080
